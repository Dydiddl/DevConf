# ==================================================
# Oh My Zsh
# ==================================================

export ZSH="$HOME/.local/share/oh-my-zsh"

ZSH_THEME="robbyrussell"

plugins=(
    git
)

source "$ZSH/oh-my-zsh.sh"

# ==================================================
# User Settings
# ==================================================

export EDITOR="nvim"
export VISUAL="nvim"
