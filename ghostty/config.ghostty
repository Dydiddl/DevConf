font-family = MartianMono Nerd Font Mono
font-family = D2CodingLigature Nerd Font Mono
font-size = 14

font-thicken = true
font-thicken-strength = 50

window-padding-x = 8
window-padding-y = 8

background-opacity = 0.7

theme = Harper

cursor-style = block
cursor-style-blink = true
cursor-opacity = 0.95

custom-shader = ~/DevConf/ghostty/shaders/cursor_smear_fade.glsl
