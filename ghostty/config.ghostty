font-family = MartianMono Nerd Font Mono
font-family = D2KodingLigature Nerd Font Mono
font-size = 12.5

font-thicken = true
font-thicken-strength = 20

window-padding-x = 8
window-padding-y = 8

background-opacity = 0.7

theme = Blue Matrix

cursor-style = block
cursor-style-blink = true
cursor-opacity = 0.95

custom-shader = ~/DevConf/ghostty/shaders/cursor_smear_fade.glsl
